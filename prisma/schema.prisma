generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Comment {
  id            String     @id
  threadId      String
  url           String?
  parentId      String?
  author        String
  content       String
  timestamp     Int?
  imageUrls     String?
  tags          String?
  upvotes       Int        @default(0)
  createdAt     DateTime   @default(now())
  isToxic       Boolean    @default(false)
  userId        String?
  category      String?
  Comment       Comment?   @relation("CommentToComment", fields: [parentId], references: [id])
  other_Comment Comment[]  @relation("CommentToComment")
  User          User?      @relation(fields: [userId], references: [id])
  Reaction      Reaction[]
  Report        Report[]

  @@index([userId])
  @@index([threadId, createdAt])
  @@index([threadId])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Comment_FTS {
  id       Unsupported("")?
  content  Unsupported("")?
  url      Unsupported("")?
  category Unsupported("")?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Comment_FTS_config {
  k Unsupported("")  @id
  v Unsupported("")?

  @@ignore
}

model Comment_FTS_data {
  id    Int    @id @default(autoincrement())
  block Bytes?
}

model Comment_FTS_docsize {
  id Int    @id @default(autoincrement())
  sz Bytes?
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Comment_FTS_idx {
  segid Unsupported("")
  term  Unsupported("")
  pgno  Unsupported("")?

  @@id([segid, term])
  @@ignore
}

model LinkStats {
  id        String   @id
  url       String   @unique
  threadId  String   @unique
  views     Int      @default(0)
  updatedAt DateTime
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean   @default(false)
  priority  Int       @default(0)  // 0=normal, 1=high, 2=critical
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, priority, createdAt])
}

model Reaction {
  id        String   @id
  emoji     String
  commentId String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([userId])
  @@index([commentId])
}

model Report {
  id         String   @id
  commentId  String
  reporterId String
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  Comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([status])
  @@index([reporterId])
  @@index([commentId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String          @id @default(uuid())
  name              String?
  username          String?         @unique
  bio               String?
  profileBackground String?
  email             String?         @unique
  emailVerified     DateTime?
  image             String?
  role              String          @default("USER")
  isBanned          Boolean         @default(false)
  isShadowBanned    Boolean         @default(false)
  isPro                Boolean         @default(false)
  subscriptionStatus   String?
  lsCustomerId         String?
  lsSubscriptionId     String?
  subscriptionEnd      DateTime?
  Account           Account[]
  Authenticator     Authenticator[]
  Comment           Comment[]
  Notification      Notification[]
  Reaction          Reaction[]
  Report            Report[]
  Session           Session[]
  UserBadge         UserBadge[]
  WebhookSubscription WebhookSubscription[]
}

model WebhookSubscription {
  id        String   @id
  url       String
  event     String   // "comment.created", "reaction.created", or "*"
  userId    String
  secret    String?  // for validating payload signature (HMAC SHA256)
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserBadge {
  id        String   @id
  userId    String
  badgeType String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeType])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
