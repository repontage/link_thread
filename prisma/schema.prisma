generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Comment {
  id            String     @id
  threadId      String
  url           String?
  parentId      String?
  author        String
  content       String
  timestamp     Int?
  imageUrls     String?
  tags          String?
  upvotes       Int        @default(0)
  createdAt     DateTime   @default(now())
  isToxic       Boolean    @default(false)
  userId        String?
  category      String?
  Comment       Comment?   @relation("CommentToComment", fields: [parentId], references: [id])
  other_Comment Comment[]  @relation("CommentToComment")
  User          User?      @relation(fields: [userId], references: [id])
  Reaction      Reaction[]
  Report        Report[]

  @@index([userId])
  @@index([threadId, createdAt])
  @@index([threadId])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Comment_FTS {
  id       Unsupported("")?
  content  Unsupported("")?
  url      Unsupported("")?
  category Unsupported("")?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Comment_FTS_config {
  k Unsupported("")  @id
  v Unsupported("")?

  @@ignore
}

model Comment_FTS_data {
  id    Int    @id @default(autoincrement())
  block Bytes?
}

model Comment_FTS_docsize {
  id Int    @id @default(autoincrement())
  sz Bytes?
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model Comment_FTS_idx {
  segid Unsupported("")
  term  Unsupported("")
  pgno  Unsupported("")?

  @@id([segid, term])
  @@ignore
}

model LinkStats {
  id        String   @id
  url       String   @unique
  threadId  String   @unique
  views     Int      @default(0)
  updatedAt DateTime
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  message   String
  isRead    Boolean   @default(false)
  priority  Int       @default(0)  // 0=normal, 1=high, 2=critical
  createdAt DateTime  @default(now())
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, priority, createdAt])
}

model Reaction {
  id        String   @id
  emoji     String
  commentId String
  userId    String
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([userId])
  @@index([commentId])
}

model Report {
  id         String   @id
  commentId  String
  reporterId String
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  Comment    Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, reporterId])
  @@index([status])
  @@index([reporterId])
  @@index([commentId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                String          @id @default(uuid())
  name              String?
  username          String?         @unique
  bio               String?
  profileBackground String?
  email             String?         @unique
  emailVerified     DateTime?
  image             String?
  role              String          @default("USER")
  isBanned          Boolean         @default(false)
  isShadowBanned    Boolean         @default(false)
  isPro                Boolean         @default(false)
  subscriptionStatus   String?
  lsCustomerId         String?
  lsSubscriptionId     String?
  lsVariantId          String?
  subscriptionEnd      DateTime?
  Account           Account[]
  Authenticator     Authenticator[]
  Comment           Comment[]
  Notification      Notification[]
  Reaction          Reaction[]
  Report            Report[]
  Session           Session[]
  UserBadge         UserBadge[]
  WebhookSubscription WebhookSubscription[]
  InviteCode         InviteCode[]
  InviteUse          InviteUse?
  Community         Community[]
  Follow            Follow[]        @relation("Following")
  FollowedBy        Follow[]        @relation("Follower")
  MessageSent       Message[]       @relation("Sender")
  MessageReceived   Message[]       @relation("Receiver")
  TeamMember        TeamMember[]
  Team              Team[]
  CommunityThread   CommunityThread[]
}

model WebhookSubscription {
  id        String   @id
  url       String
  event     String   // "comment.created", "reaction.created", or "*"
  userId    String
  secret    String?  // for validating payload signature (HMAC SHA256)
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InviteCode {
  id         String      @id @default(uuid())
  code       String      @unique
  creatorId  String
  maxUses    Int         @default(10)
  useCount   Int         @default(0)
  createdAt  DateTime    @default(now())
  expiresAt  DateTime
  creator    User        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  uses       InviteUse[]
}

model InviteUse {
  id          String     @id @default(uuid())
  inviteId    String
  userId      String     @unique
  rewardGiven Boolean    @default(false)
  createdAt   DateTime   @default(now())
  invite      InviteCode @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Phase 26: Community & UGC
model Community {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  creatorId   String
  createdAt   DateTime @default(now())
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  threads     CommunityThread[]

  @@index([slug])
}

model CommunityThread {
  id          String    @id @default(uuid())
  communityId String
  url         String
  title       String?
  addedById   String
  addedAt     DateTime  @default(now())
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  addedBy     User      @relation(fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([communityId, url])
  @@index([communityId, addedAt])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Message {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime  @default(now())
  readAt     DateTime?
  sender     User      @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User      @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, readAt])
}

// Phase 27: Monetization 2.0
model Team {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  ownerId     String
  createdAt   DateTime     @default(now())
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]

  @@index([slug])
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  userId   String
  role     String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  joinedAt DateTime @default(now())
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model SponsoredLink {
  id          String    @id @default(uuid())
  url         String
  title       String
  description String?
  sponsorName String
  imageUrl    String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeType String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, badgeType])
  @@index([userId])
}
