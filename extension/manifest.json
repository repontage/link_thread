{
  "manifest_version": 3,
  "name": "VoidSay Extension",
  "version": "1.1",
  "description": "Read and post VoidSay comments on any website.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VoidSay"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
